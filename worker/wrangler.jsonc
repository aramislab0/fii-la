// Fii — Worker Cloudflare (docs/PLAN-DOMAINES-FII.md). Pas encore en ligne : la mise en ligne attend le compte Cloudflare
// d'Aramis Lab et l'accord du fondateur. Aucun secret ici (la clé Supabase est la clé publique, déjà servie par config.js).
{
  "name": "fii",
  "main": "index.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    // Le Worker décide pour la page d'accueil et les fichiers propres à l'application ; « html_handling: none » et
    // « not_found_handling: none » : aucune autre adresse ne renvoie la page, donc jamais l'application sur un domaine non vérifié.
    "run_worker_first": ["/", "/index.html", "/sw.js", "/manifest.webmanifest", "/.well-known/apple-app-site-association"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "FII_HOSTS": "getfii.app",
    "CANONICAL_HOST": "getfii.app",
    "SHOP_ZONE": "getfii.app",
    "LEGACY_PREFIX": "https://aramislab0.github.io/fii-la/",
    "SUPABASE_URL": "https://lkvulwocirttozfnyxck.supabase.co",
    "SUPABASE_ANON_KEY": "REMPLACÉ_PAR_LA_CI"
  },
  // Production (bascule, accord du fondateur) : getfii.app et www en domaines personnalisés du Worker ; *.getfii.app/* (sites des
  // boutiques) demande un enregistrement DNS « * » proxifié dans la zone. Les variables sont reprises à l'identique.
  "env": {
    "production": {
      "name": "fii",
      "routes": [
        { "pattern": "getfii.app", "custom_domain": true },
        { "pattern": "www.getfii.app", "custom_domain": true },
        { "pattern": "*.getfii.app/*", "zone_name": "getfii.app" }
      ],
      "vars": {
        "FII_HOSTS": "getfii.app",
        "CANONICAL_HOST": "getfii.app",
        "SHOP_ZONE": "getfii.app",
        "LEGACY_PREFIX": "https://aramislab0.github.io/fii-la/",
        "SUPABASE_URL": "https://lkvulwocirttozfnyxck.supabase.co",
        "SUPABASE_ANON_KEY": "REMPLACÉ_PAR_LA_CI"
      }
    }
  }
  // Domaine acheté le 26/10/2026 (Porkbun) : getfii.app, pour l'application et les sites des boutiques (<lien>.getfii.app).
  // Routes (à la bascule, accord du fondateur) : getfii.app/*, *.getfii.app/* ; */* pour les domaines propres (Cloudflare for SaaS
  // sur la zone getfii.app, cible sites.getfii.app).
}
